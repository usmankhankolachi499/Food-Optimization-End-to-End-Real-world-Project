# Copy to .env and adjust for your machine
# NOTE: keep secrets out of the repo - use real values only in .env (gitignored)
SECRET_KEY=replace-with-a-long-random-string
APP_NAME=MOON Light
FLASK_ENV=development

# Main database: SQL Server Express (default). See MSSQL_* below.
# Fallback (only if SQL Server is unavailable): set USE_MSSQL=False
# DATABASE_PATH=C:/path/to/food_delivery.db

# SQL Server connection (main backend)
MSSQL_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=.\SQLEXPRESS;DATABASE=food_delivery_sys;Trusted_Connection=yes;
MSSQL_DATABASE=food_delivery_sys
USE_MSSQL=True

# Code required to sign up as Admin / Delivery Partner (change this!)
STAFF_SIGNUP_CODE=change-this-staff-code

SESSION_TIMEOUT_MINUTES=30
CSRF_ENABLED=true
AUTO_CREATE_DB=true
AUTO_ASSIGN_ORDERS=true

# Optional MongoDB for GPS tracking mirror (263k+ points ingest)
MONGO_URI=
MONGO_DB=moonlight_tracking
MONGO_COLLECTION=location_logs

# ML delivery-time model
ML_ENABLED=true
ML_MODULE=ml.predictor
