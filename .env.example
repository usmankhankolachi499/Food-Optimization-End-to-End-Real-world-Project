# Copy to .env and adjust for your machine
SECRET_KEY=replace-with-a-long-random-string
APP_NAME=SwiftBite
FLASK_ENV=development

# SQLite database file (created automatically)
# DATABASE_PATH=C:/path/to/food_delivery.db
# Optional alternative: DATABASE_URL=sqlite:///C:/path/to/food_delivery.db

SESSION_TIMEOUT_MINUTES=30
CSRF_ENABLED=true
AUTO_CREATE_DB=true
AUTO_ASSIGN_ORDERS=true

# Optional MongoDB for location logs
MONGO_URI=
MONGO_DB=food_delivery
MONGO_COLLECTION=location_logs

# Optional ML integration point (built separately)
ML_ENABLED=true
ML_MODULE=ml.predictor
